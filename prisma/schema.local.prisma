// LOCAL DEV schema — SQLite.
//
// To develop locally:
//   1. cp prisma/schema.local.prisma prisma/schema.prisma
//   2. Set DATABASE_URL="file:./dev.db" in .env
//   3. bun install && bun run db:push && bun run dev
//
// IMPORTANT: the repo prisma/schema.prisma is already the PostgreSQL version
// for Vercel — restore it (git checkout) before pushing.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String   @id @default("profile")
  name          String   @default("Syed")
  heroGreeting  String   @default("Hi! I'm")
  roles         String   @default("Frontend Developer,CS Student")
  rotatingRoles String   @default("Software Developer,Frontend Developer,CS Student,Designer,Creator,Problem Solver")
  city          String   @default("")
  bio           String   @default("")
  manifesto     String   @default("I build software that does the boring parts of life so you can stay in *flow*. Small, sharp products — fast UI, clean data, and the kind of details that only show up after the second cup of coffee.")
  nowWorkingOn  String   @default("Shipping a *new project* with React + Next.js. Real users, real deadlines, real commits.")
  nowCurrently  String   @default("*Software Developer.* Always building, always learning — usually with too many tabs open.")
  nowReading    String   @default("Clean Code, the docs for whatever framework I last broke, and the same three threads on Hacker News.")
  quoteText     String   @default("If it doesn't ship, it doesn't exist.")
  quoteAttribution String @default("house rule")
  email         String   @default("contact@syeds-den.com")
  phone         String   @default("+123 456 7890")
  location      String   @default("City, Country")
  heroImage     String   @default("/images/hero-character.png")
  aboutImage    String   @default("/images/about-character.png")
  github        String   @default("https://github.com")
  instagram     String   @default("https://instagram.com")
  linkedin      String   @default("https://linkedin.com")
  logoText      String   @default("Syed's-Den")
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String   @default("")
  technologies String   @default("")
  githubUrl    String   @default("")
  liveUrl      String   @default("")
  coverImage   String   @default("")
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
}

model Service {
  id          String @id @default(cuid())
  title       String
  description String
  icon        String // lucide icon name
  order       Int    @default(0)

  @@index([order])
}

model TechStack {
  id    String @id @default(cuid())
  name  String
  icon  String // simple-icons slug
  order Int    @default(0)

  @@index([order])
}

model Stat {
  id     String @id @default(cuid())
  label  String
  value  Int
  suffix String @default("+")
  order  Int    @default(0)

  @@index([order])
}

model SiteSettings {
  id               String   @id @default("settings")
  availabilityText String   @default("Available for projects")
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Images uploaded from the admin panel (project covers, profile photos).
// Stored base64 in the DB so uploads survive on serverless (Vercel) where
// the filesystem is read-only. Served via GET /api/images/[id].
model UploadedImage {
  id        String   @id @default(cuid())
  mime      String
  data      String
  createdAt DateTime @default(now())
}
